<Shell
    x:Class="RegistroDeTareas.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RegistroDeTareas"
    xmlns:views="clr-namespace:RegistroDeTareas.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="RegistroDeTareas">

    <!-- La página inicial por defecto que se cargará dentro del contenedor de Shell -->
    <ShellContent
        Title="Pendientes"
        ContentTemplate="{DataTemplate views:TodoListPage}"
        Route="TodoListPage" />

    <!-- Registro de la página de completadas para permitir navegación por ruta -->
    <ShellContent
        Title="Completadas"
        ContentTemplate="{DataTemplate views:TareasCompletadasPage}"
        Route="TareasCompletadasPage" />

</Shell>